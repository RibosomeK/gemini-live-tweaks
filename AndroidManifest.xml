<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="moe.debug.geminilive"
    android:versionCode="4"
    android:versionName="1.3">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <application
        android:label="Gemini Live Tweaks"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:hasCode="true">
        <activity
            android:name=".SettingsActivity"
            android:label="Gemini Live Tweaks"
            android:exported="true">
            <!-- Lets LSPosed Manager show its "module settings" launch button. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".SettingsActivity"
            android:label="Gemini Live Tweaks"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name=".SettingsProvider"
            android:authorities="moe.debug.geminilive.settings"
            android:exported="true" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Start Gemini Live from the lock screen, make plain &quot;Hey Google&quot; wake enter Live, and exit Gemini after Live ends (Google app only)." />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>
</manifest>
